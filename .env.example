# Copy to .env.local and fill in. Never commit .env.local.

# Server-side credentials, used only by `npm run upload:frames`.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Client-side delivery. The cloud name is public; it appears in every URL.
VITE_CLOUDINARY_CLOUD_NAME=
# Set to false to serve frames from public/frames instead.
VITE_USE_CLOUDINARY=true
